# Local development environment variables (copy to `.env`)
#
# Railway Postgres:
# - Prefer the *public* connection string if running locally.
# - In Railway, this is often exposed as DATABASE_PUBLIC_URL (or shown in the plugin's "Connect" section).
#
# Example:
# DATABASE_URL=postgresql://user:password@host:port/dbname

PORT=3000

# Use Railway Postgres data from your local server:
DATABASE_URL=

# SSL is typically required for managed Postgres providers (Railway, Neon, Supabase, etc).
# Set to "false" only if you're connecting to a local Postgres instance without SSL.
DATABASE_SSL=true

# Session secret for cookie signing. Required in production; dev fallback used otherwise.
SESSION_SECRET=

# Password required when registering as teacher or director. Set in production.
REGISTRATION_PASSWORD=

# Optional: create demo director/teacher users on DB init. Default: true when NODE_ENV is not "production".
# DEMO_USERS_ENABLED=false

# Optional: director email for message centre (messages are copied to this user). Default: jatlee@stpeters.co.za
# DIRECTOR_EMAIL=

# Optional: if your frontend is on a different host than the API (e.g. Vercel + Railway), set its full origin
# so CORS and session cookies work. Example: FRONTEND_ORIGIN=https://myapp.vercel.app
# FRONTEND_ORIGIN=




